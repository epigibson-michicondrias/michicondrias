{
    "cli": {
        "version": ">= 12.0.0",
        "appVersionSource": "local"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://michicondrias.duckdns.org"
            }
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview",
            "env": {
                "EXPO_PUBLIC_API_URL": "https://michicondrias.duckdns.org"
            }
        },
        "production": {
            "channel": "production",
            "autoIncrement": true,
            "env": {
                "EXPO_PUBLIC_API_URL": "https://michicondrias.duckdns.org"
            }
        },
        "apk": {
            "distribution": "internal",
            "android": {
                "buildType": "apk"
            },
            "env": {
                "EXPO_PUBLIC_API_URL": "https://michicondrias.duckdns.org"
            }
        }
    },
    "submit": {
        "production": {}
    }
}
