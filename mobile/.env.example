# Michigancondrias Mobile - Environment Variables Template

# URL base de la API (sin slash final). Un solo valor que cambia según el proveedor:
#   Oracle/VM : https://api.michicondrias.com
#   AWS       : https://kowly51wia.execute-api.us-east-1.amazonaws.com
EXPO_PUBLIC_API_URL=https://api.michicondrias.com

# URL pública del storage de archivos (debe coincidir con STORAGE_PUBLIC_BASE_URL del backend)
#   AWS S3    : https://michicondrias-storage-1.s3.us-east-1.amazonaws.com
#   Oracle OCI: https://objectstorage.<region>.oraclecloud.com/n/<namespace>/b/<bucket>/o
EXPO_PUBLIC_STORAGE_URL=https://michicondrias-storage-1.s3.us-east-1.amazonaws.com

# Google Maps API Key (Necesaria para Android)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=TU_API_KEY_AQUI

# Contacto de soporte (Centro de Ayuda). Los canales sin valor se ocultan en la app.
EXPO_PUBLIC_SUPPORT_EMAIL=soporte@michicondrias.com
EXPO_PUBLIC_SUPPORT_PHONE=
EXPO_PUBLIC_SUPPORT_WHATSAPP=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
