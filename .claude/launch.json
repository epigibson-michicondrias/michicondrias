{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "mobile-web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "mobile",
        "expo",
        "start",
        "--web",
        "--port",
        "3000"
      ],
      "cwd": "mobile",
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3001
    }
  ]
}
