[Unit]
Description=Michicondrias %i (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
User=michicondrias
Group=michicondrias
EnvironmentFile=/etc/michicondrias/common.env
EnvironmentFile=-/etc/michicondrias/%i.env
ExecStart=/opt/michicondrias/run-service.sh %i
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target
