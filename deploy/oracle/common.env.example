# Copiar a /etc/michicondrias/common.env (chmod 640, root:michicondrias). NO commitear valores reales.
# Para sobreescribir algo en un solo servicio: /etc/michicondrias/<servicio>.env

DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
SECRET_KEY=cambia-esto-por-un-secreto-largo
RESEND_API_KEY=

# URL pública de la API; los servicios la usan para llamarse entre sí (<API_GATEWAY_URL>/core, /mascotas...)
API_GATEWAY_URL=https://api.michicondrias.com
FRONTEND_URL=https://michicondrias.com

# --- Storage S3-compatible: Oracle Object Storage ---
S3_BUCKET_NAME=michicondrias-storage
AWS_REGION=us-ashburn-1
# "Customer Secret Key" de OCI (los comentarios van en su propia línea: systemd no soporta comentarios al final)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=https://<namespace>.compat.objectstorage.us-ashburn-1.oraclecloud.com
S3_ADDRESSING_STYLE=path
STORAGE_PUBLIC_BASE_URL=https://objectstorage.us-ashburn-1.oraclecloud.com/n/<namespace>/b/michicondrias-storage/o

# --- Storage S3-compatible: volver a AWS S3 (dejar vacíos S3_ENDPOINT_URL y STORAGE_PUBLIC_BASE_URL) ---
# S3_BUCKET_NAME=michicondrias-storage-1
# AWS_REGION=us-east-1
# S3_ADDRESSING_STYLE=virtual

# --- Triage con IA (servicio mascotas). Sin clave el triage usa solo reglas de urgencia. ---
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5
# AI_RATE_LIMIT_PER_HOUR=10

# --- Token compartido entre servicios (ecommerce -> mascotas): sin él no se pueden activar suscripciones Pro. ---
# Genera uno con: openssl rand -hex 32
# INTERNAL_SERVICE_TOKEN=

# --- Bucket PRIVADO para documentos de identidad (KYC). Debe tener visibilidad privada, a diferencia del bucket público de fotos. ---
S3_PRIVATE_BUCKET_NAME=michicondrias-private
